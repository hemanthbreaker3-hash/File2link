# HITLER configuration
# Required
API_ID=YOUR_API_ID
API_HASH=YOUR_API_HASH
BOT_TOKEN=YOUR_BOT_TOKEN
OWNER_ID=YOUR_TELEGRAM_USER_ID

# Optional admin / channel settings
ADMINS=
CHANNEL_ID=
FORCE_SUB_CHANNELS=

# Database
# Docker Compose defaults to the bundled MongoDB/Redis services.
# For Render, Koyeb, Heroku or another single-container platform, use an external MongoDB URI.
MONGODB_URI=mongodb://mongodb:27017
DATABASE_NAME=tg_media_bot
REDIS_URL=redis://redis:6379/0

# Public URL used in generated links
BASE_URL=https://your-domain.example

# Runtime
PORT=8000
DEBUG=False
DEFAULT_EXPIRY=24

# Optional Telethon user sessions, comma-separated StringSession values
SESSIONS=

# Optional: protect the /admin pages with HTTP Basic (username: admin).
# Leave empty to keep the admin panel disabled.
ADMIN_PANEL_TOKEN=

# Stream read size (64 KiB–1 MiB).
STREAM_CHUNK_SIZE=524288
