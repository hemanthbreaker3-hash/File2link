# Required
API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=

# Optional admin IDs (comma-separated)
ADMINS=

# Optional force-subscription channel IDs (comma-separated)
FORCE_SUB_CHANNELS=

# Optional log channel ID
CHANNEL_ID=

# Public URL of this service
BASE_URL=http://localhost:8000
PORT=8000

# External services
MONGODB_URI=mongodb://mongodb:27017/anizoneflix
REDIS_URL=redis://redis:6379/0

# Link expiry in hours. 0 disables expiry.
DEFAULT_EXPIRY=24

# Optional Telethon StringSession values, comma-separated
SESSIONS=

# Admin web panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

DEBUG=false
