#!/usr/bin/env bash

# ==============================================================================
# Telegram Direct Media Streamer & Link Generator - VPS Deployer
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

echo -e "${CYAN}"
echo "====================================================================="
echo "   🚀 TELEGRAM DIRECT MEDIA STREAMER & LINK GENERATOR - DEPLOYER    "
echo "====================================================================="
echo -e "${NC}"

info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# 1. Check Root or Sudo Privileges
if [ "$EUID" -ne 0 ]; then
    warning "Running without root privileges. If Docker operations fail, run with 'sudo ./deploy.vps'."
fi

# 2. Check System Prerequisites
info "Checking system prerequisites..."
if ! command -v curl &> /dev/null; then
    info "Installing curl..."
    if command -v apt-get &> /dev/null; then
        sudo apt-get update && sudo apt-get install -y curl
    elif command -v yum &> /dev/null; then
        sudo yum install -y curl
    fi
fi

# 3. Check / Install Docker
if ! command -v docker &> /dev/null; then
    info "Docker not found. Installing Docker..."
    curl -fsSL https://get.docker.com -o get-docker.sh
    sudo sh get-docker.sh
    rm -f get-docker.sh
    if command -v systemctl &> /dev/null; then
        sudo systemctl start docker || true
        sudo systemctl enable docker || true
    fi
    success "Docker installed successfully."
fi

# Determine Docker Compose command
DOCKER_COMPOSE_CMD=""
if docker compose version &> /dev/null; then
    DOCKER_COMPOSE_CMD="docker compose"
elif command -v docker-compose &> /dev/null; then
    DOCKER_COMPOSE_CMD="docker-compose"
else
    info "Installing Docker Compose plugin..."
    if command -v apt-get &> /dev/null; then
        sudo apt-get update && sudo apt-get install -y docker-compose-plugin || sudo apt-get install -y docker-compose
    fi
    if docker compose version &> /dev/null; then
        DOCKER_COMPOSE_CMD="docker compose"
    elif command -v docker-compose &> /dev/null; then
        DOCKER_COMPOSE_CMD="docker-compose"
    else
        error "Docker Compose installation failed. Please install docker-compose manually."
    fi
fi

info "Using Compose Command: ${DOCKER_COMPOSE_CMD}"

# 4. Handle Environment File (.env)
if [ ! -f .env ]; then
    if [ -f .env.example ]; then
        info ".env file not found. Creating from .env.example..."
        cp .env.example .env
    else
        touch .env
    fi
fi

# Convert Windows CRLF line endings to Linux LF if present
tr -d '\r' < .env > .env.tmp && mv .env.tmp .env

# Check for required variable values
get_env_val() {
    grep -E "^${1}=" .env 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'" | tr -d ' '
}

API_ID_VAL=$(get_env_val "API_ID")
API_HASH_VAL=$(get_env_val "API_HASH")
BOT_TOKEN_VAL=$(get_env_val "BOT_TOKEN")
OWNER_ID_VAL=$(get_env_val "OWNER_ID")

is_missing() {
    [ -z "$1" ] || [ "$1" = "your_api_id" ] || [ "$1" = "your_api_hash" ] || [ "$1" = "your_bot_token" ] || [ "$1" = "your_owner_id" ]
}

# If running interactively and variables are missing, prompt user
if is_missing "$API_ID_VAL" || is_missing "$API_HASH_VAL" || is_missing "$BOT_TOKEN_VAL" || is_missing "$OWNER_ID_VAL"; then
    if [ -t 0 ]; then
        echo -e "${YELLOW}"
        echo "====================================================================="
        echo "⚙️  CONFIGURATION SETUP REQUIRED (.env)"
        echo "====================================================================="
        echo -e "${NC}"

        if is_missing "$API_ID_VAL"; then
            read -p "Enter API_ID: " INPUT_API_ID
            sed -i.bak '/^API_ID=/d' .env 2>/dev/null || true
            echo "API_ID=${INPUT_API_ID}" >> .env
        fi

        if is_missing "$API_HASH_VAL"; then
            read -p "Enter API_HASH: " INPUT_API_HASH
            sed -i.bak '/^API_HASH=/d' .env 2>/dev/null || true
            echo "API_HASH=${INPUT_API_HASH}" >> .env
        fi

        if is_missing "$BOT_TOKEN_VAL"; then
            read -p "Enter BOT_TOKEN: " INPUT_BOT_TOKEN
            sed -i.bak '/^BOT_TOKEN=/d' .env 2>/dev/null || true
            echo "BOT_TOKEN=${INPUT_BOT_TOKEN}" >> .env
        fi

        if is_missing "$OWNER_ID_VAL"; then
            read -p "Enter OWNER_ID: " INPUT_OWNER_ID
            sed -i.bak '/^OWNER_ID=/d' .env 2>/dev/null || true
            echo "OWNER_ID=${INPUT_OWNER_ID}" >> .env
        fi
    else
        warning "Missing mandatory credentials in .env and non-interactive terminal detected."
        warning "Please configure API_ID, API_HASH, BOT_TOKEN, and OWNER_ID in .env before running."
    fi
fi

# Ensure internal Docker container database connection strings
if ! grep -q "^MONGODB_URI=" .env || grep -q "^MONGODB_URI=.*localhost" .env; then
    sed -i.bak '/^MONGODB_URI=/d' .env 2>/dev/null || true
    echo "MONGODB_URI=mongodb://mongodb:27017/tg_media_bot" >> .env
fi

if ! grep -q "^REDIS_URL=" .env || grep -q "^REDIS_URL=.*localhost" .env; then
    sed -i.bak '/^REDIS_URL=/d' .env 2>/dev/null || true
    echo "REDIS_URL=redis://redis:6379/0" >> .env
fi

if ! grep -q "^BASE_URL=" .env; then
    echo "BASE_URL=http://localhost:8000" >> .env
fi

rm -f .env.bak 2>/dev/null || true

# 5. Stop existing services and rebuild
info "Shutting down existing containers if running..."
$DOCKER_COMPOSE_CMD down --remove-orphans 2>/dev/null || true

info "Building Docker image and launching containers..."
$DOCKER_COMPOSE_CMD up -d --build

# 6. Verify Deployment Health
info "Waiting for application services to initialize..."
sleep 5

echo -e "${CYAN}"
echo "====================================================================="
echo "🎉 DEPLOYMENT STATUS SUMMARY"
echo "====================================================================="
echo -e "${NC}"

$DOCKER_COMPOSE_CMD ps

echo
if $DOCKER_COMPOSE_CMD ps | grep -q "web"; then
    success "Bot & Streamer deployed and started successfully!"
    echo
    info "To check live bot logs, run:"
    echo -e "${GREEN}  $DOCKER_COMPOSE_CMD logs -f web${NC}"
    echo
    info "To restart services, run:"
    echo -e "${GREEN}  $DOCKER_COMPOSE_CMD restart${NC}"
else
    error "Containers failed to start. View error logs with: $DOCKER_COMPOSE_CMD logs"
fi
