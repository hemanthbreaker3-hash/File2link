#!/usr/bin/env bash

# ==============================================================================
# Telegram Direct Media Streamer & Link Generator - One-Click VPS Deployer
# ==============================================================================

set -eo pipefail

export DEBIAN_FRONTEND=noninteractive

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

echo -e "${CYAN}"
echo "====================================================================="
echo "   🚀 TELEGRAM DIRECT MEDIA STREAMER & LINK GENERATOR - DEPLOYER    "
echo "====================================================================="
echo -e "${NC}"

# Helper function for running commands with sudo if not root
run_cmd() {
    if [ "$(id -u)" -ne 0 ]; then
        if command -v sudo &> /dev/null; then
            sudo "$@"
        else
            echo -e "${RED}[ERROR] Sudo is required to run: $@${NC}"
            exit 1
        fi
    else
        "$@"
    fi
}

info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# 1. Check Root or Sudo
if [ "$(id -u)" -ne 0 ]; then
    warning "Running without root privileges. Commands requiring elevated rights will use sudo."
fi

# 2. Verify System Dependencies (curl, git)
info "Checking system prerequisites..."
if ! command -v curl &> /dev/null; then
    info "Installing curl..."
    if command -v apt-get &> /dev/null; then
        run_cmd apt-get update -qq && run_cmd apt-get install -y -qq curl
    elif command -v dnf &> /dev/null; then
        run_cmd dnf install -y curl
    elif command -v yum &> /dev/null; then
        run_cmd yum install -y curl
    elif command -v apk &> /dev/null; then
        run_cmd apk add --no-cache curl
    fi
fi

# 3. Check / Install Docker & Docker Compose
if ! command -v docker &> /dev/null; then
    info "Docker is not installed. Installing Docker..."
    curl -fsSL https://get.docker.com -o get-docker.sh
    run_cmd sh get-docker.sh
    rm -f get-docker.sh
    success "Docker installed successfully."
fi

# Ensure docker daemon is active
if command -v systemctl &> /dev/null; then
    run_cmd systemctl start docker 2>/dev/null || true
fi

# Determine Docker Compose command
DOCKER_COMPOSE_CMD=""
if docker compose version &> /dev/null; then
    DOCKER_COMPOSE_CMD="docker compose"
elif command -v docker-compose &> /dev/null; then
    DOCKER_COMPOSE_CMD="docker-compose"
else
    info "Docker Compose plugin not found. Installing..."
    if command -v apt-get &> /dev/null; then
        run_cmd apt-get update -qq && run_cmd apt-get install -y -qq docker-compose-plugin 2>/dev/null || true
    elif command -v dnf &> /dev/null; then
        run_cmd dnf install -y docker-compose-plugin 2>/dev/null || true
    elif command -v yum &> /dev/null; then
        run_cmd yum install -y docker-compose-plugin 2>/dev/null || true
    fi

    if docker compose version &> /dev/null; then
        DOCKER_COMPOSE_CMD="docker compose"
    elif command -v docker-compose &> /dev/null; then
        DOCKER_COMPOSE_CMD="docker-compose"
    else
        error "Docker Compose installation failed. Please install docker-compose manually."
    fi
fi

info "Using Docker Compose command: ${DOCKER_COMPOSE_CMD}"

# 4. Check Environment Configuration (.env)
if [ ! -f .env ]; then
    if [ -f .env.example ]; then
        warning ".env file not found. Copying from .env.example..."
        cp .env.example .env
        success "Created .env from .env.example."
    else
        error ".env file missing and .env.example is not present!"
    fi
fi

# Sanitize .env file to strip trailing inline comments like "  # For log storage (optional)"
sed -i.bak -E 's/[[:space:]]*#.*$//' .env 2>/dev/null || true

# Ensure internal MongoDB & Redis connection URIs for Docker service networking
if ! grep -q "^MONGODB_URI=" .env || grep -qE "^MONGODB_URI=.*localhost" .env || grep -qE "^MONGODB_URI=.*127\.0\.0\.1" .env; then
    if grep -q "^MONGODB_URI=" .env; then
        sed -i.bak 's|^MONGODB_URI=.*|MONGODB_URI=mongodb://mongodb:27017/tg_media_bot|g' .env 2>/dev/null || true
    else
        echo "MONGODB_URI=mongodb://mongodb:27017/tg_media_bot" >> .env
    fi
fi

if ! grep -q "^REDIS_URL=" .env || grep -qE "^REDIS_URL=.*localhost" .env || grep -qE "^REDIS_URL=.*127\.0\.0\.1" .env; then
    if grep -q "^REDIS_URL=" .env; then
        sed -i.bak 's|^REDIS_URL=.*|REDIS_URL=redis://redis:6379/0|g' .env 2>/dev/null || true
    else
        echo "REDIS_URL=redis://redis:6379/0" >> .env
    fi
fi

# Clean up backup file if generated
rm -f .env.bak 2>/dev/null || true

# Validate Required Environment Variables
MISSING_VARS=0
for var in API_ID API_HASH BOT_TOKEN OWNER_ID; do
    VAL=$(grep -E "^${var}=" .env | cut -d'=' -f2- | tr -d '"' | tr -d "'" | tr -d ' ' || true)
    if [ -z "$VAL" ] || [ "$VAL" == "123456" ] || [ "$VAL" == "your_api_id" ] || [ "$VAL" == "abcdef1234567890" ] || [ "$VAL" == "your_api_hash" ] || [ "$VAL" == "123456789:ABCDEF-GHIJKLMN-OPQRSTUVWXYZ" ] || [ "$VAL" == "your_bot_token" ]; then
        warning "Variable ${var} in .env is missing or using default/placeholder value!"
        MISSING_VARS=1
    fi
done

if [ "$MISSING_VARS" -eq 1 ]; then
    warning "Please update your .env file with your Telegram credentials before production use."
    echo -e "${YELLOW}Required variables in .env:${NC}"
    echo "  - API_ID"
    echo "  - API_HASH"
    echo "  - BOT_TOKEN"
    echo "  - OWNER_ID"
    echo "  - BASE_URL"

    if [ -t 0 ] && [ "${ALLOW_MISSING_ENV:-0}" -ne 1 ]; then
        read -p "Do you want to continue deployment anyway? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            error "Deployment stopped to allow editing .env."
        fi
    else
        warning "Non-interactive environment detected. Proceeding with current .env configuration..."
    fi
fi

# 5. Build and Launch Containers
info "Building Docker images and starting services..."
$DOCKER_COMPOSE_CMD down --remove-orphans 2>/dev/null || true
$DOCKER_COMPOSE_CMD up -d --build

# 6. Verify Deployment
info "Waiting for service health checks..."
MAX_ATTEMPTS=12
ATTEMPT=0
SERVICES_READY=0

while [ $ATTEMPT -lt $MAX_ATTEMPTS ]; do
    sleep 3
    ATTEMPT=$((ATTEMPT + 1))

    # Check if web container is running
    if $DOCKER_COMPOSE_CMD ps --services --filter "status=running" 2>/dev/null | grep -q "web"; then
        SERVICES_READY=1
        break
    fi
    info "Waiting for containers to initialize ($ATTEMPT/$MAX_ATTEMPTS)..."
done

if [ "$SERVICES_READY" -eq 1 ]; then
    success "Deployment completed successfully! All containers are up and running."
    echo -e "${CYAN}"
    echo "====================================================================="
    echo "🎉 SERVICE STATUS SUMMARY"
    echo "====================================================================="
    echo -e "${NC}"
    $DOCKER_COMPOSE_CMD ps
    echo
    info "To view live application logs, run:"
    echo -e "${GREEN}  $DOCKER_COMPOSE_CMD logs -f web${NC}"
    echo
    info "To stop services, run:"
    echo -e "${GREEN}  $DOCKER_COMPOSE_CMD down${NC}"
    echo
    info "To restart services, run:"
    echo -e "${GREEN}  $DOCKER_COMPOSE_CMD restart${NC}"
else
    warning "Containers status check:"
    $DOCKER_COMPOSE_CMD ps || true
    warning "Recent container logs:"
    $DOCKER_COMPOSE_CMD logs --tail 30 || true
    error "Containers failed to start cleanly. Please check the logs above."
fi
