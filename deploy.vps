#!/usr/bin/env bash
set -Eeuo pipefail

APP="ANIZONEFLIX"
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
info(){ echo -e "${GREEN}[${APP}]${NC} $*"; }
warn(){ echo -e "${YELLOW}[WARN]${NC} $*"; }
die(){ echo -e "${RED}[ERROR]${NC} $*"; exit 1; }

sudo_cmd(){ if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }

command -v curl >/dev/null 2>&1 || {
  if command -v apt-get >/dev/null 2>&1; then sudo_cmd apt-get update -qq; sudo_cmd apt-get install -y -qq curl
  elif command -v dnf >/dev/null 2>&1; then sudo_cmd dnf install -y curl
  else die "curl is required."; fi
}
command -v docker >/dev/null 2>&1 || {
  info "Installing Docker..."
  curl -fsSL https://get.docker.com | sudo_cmd sh
}
sudo_cmd systemctl enable --now docker 2>/dev/null || true

if docker compose version >/dev/null 2>&1; then
  COMPOSE="docker compose"
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE="docker-compose"
else
  die "Docker Compose is unavailable. Install the Docker Compose plugin and rerun."
fi

[ -f .env ] || {
  [ -f .env.example ] || die ".env.example is missing."
  cp .env.example .env
  warn ".env created from .env.example. Fill in Telegram credentials before continuing."
}

# Refuse obvious placeholders rather than deploying a broken container.
for key in API_ID API_HASH BOT_TOKEN OWNER_ID; do
  value="$(grep -E "^${key}=" .env | head -n1 | cut -d= -f2- || true)"
  case "$value" in ""|YOUR_*|your_*|123456*) die "$key is not configured in .env.";; esac
done

# Compose service networking must use service names, not localhost.
if grep -qE '^MONGODB_URI=(mongodb://)?(localhost|127\.0\.0\.1)' .env; then
  sed -i.bak -E 's#^MONGODB_URI=.*#MONGODB_URI=mongodb://mongodb:27017/tg_media_bot#' .env
  rm -f .env.bak
fi
if grep -qE '^REDIS_URL=(redis://)?(localhost|127\.0\.0\.1)' .env; then
  sed -i.bak -E 's#^REDIS_URL=.*#REDIS_URL=redis://redis:6379/0#' .env
  rm -f .env.bak
fi

info "Building and starting ANIZONEFLIX..."
$COMPOSE up -d --build --remove-orphans

info "Waiting for health endpoint..."
for i in $(seq 1 30); do
  if curl -fsS "http://127.0.0.1:${PORT:-8000}/health" >/dev/null 2>&1; then
    info "ANIZONEFLIX is healthy on port ${PORT:-8000}."
    $COMPOSE ps
    exit 0
  fi
  sleep 2
done

$COMPOSE ps || true
$COMPOSE logs --tail=80 web || true
die "The web service did not become healthy."
